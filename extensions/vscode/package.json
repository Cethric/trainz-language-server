{
  "name": "trainz-language-server-vscode",
  "publisher": "trainz-language-server",
  "displayName": "Trainz GS Language Server",
  "description": "Language Server extension for Trainz GS",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:game-script",
    "onLanguage:soup"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "game-script",
        "aliases": [
          "GS",
          "gs",
          "GameScript"
        ],
        "extensions": [
          ".gs"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "soup",
        "aliases": [
          "SOUP",
          "soup"
        ],
        "extensions": [
          ".txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Trainz GS LSP configuration",
      "properties": {
        "trainz-language-server.serverPath": {
          "type": "string",
          "default": "trainz-language-server",
          "description": "Path to the trainz-language-server executable"
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "game-script",
        "scopes": {
          "keyword": [
            "keyword.control.gs"
          ],
          "class": [
            "entity.name.type.class.gs"
          ],
          "string": [
            "string.quoted.double.gs"
          ],
          "type": [
            "entity.name.type.gs"
          ],
          "method": [
            "entity.name.function.gs"
          ],
          "operator": [
            "keyword.operator.gs"
          ],
          "number": [
            "constant.numeric.gs"
          ],
          "property": [
            "variable.other.property.gs"
          ],
          "parameter": [
            "variable.parameter.gs"
          ],
          "modifier": [
            "storage.modifier.gs"
          ],
          "variable": [
            "variable.other.gs"
          ],
          "comment": [
            "comment.line.double-slash.gs"
          ]
        }
      },
      {
        "language": "soup",
        "scopes": {
          "keyword": [
            "keyword.control.soup"
          ],
          "class": [
            "entity.name.type.class.soup"
          ],
          "string": [
            "string.quoted.double.soup"
          ],
          "type": [
            "entity.name.type.soup"
          ],
          "method": [
            "entity.name.function.soup"
          ],
          "operator": [
            "keyword.operator.soup"
          ],
          "number": [
            "constant.numeric.soup"
          ],
          "property": [
            "variable.other.property.soup"
          ],
          "parameter": [
            "variable.parameter.soup"
          ],
          "modifier": [
            "storage.modifier.soup"
          ],
          "variable": [
            "variable.other.soup"
          ],
          "comment": [
            "comment.line.double-slash.soup"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm compile && pnpm lint",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "vscode-languageclient": "10.0.0-next.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.39",
    "@types/sinon": "^21.0.1",
    "@types/vscode": "^1.115.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.2.0",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "mocha": "^11.7.5",
    "mocha-junit-reporter": "^2.0.0",
    "sinon": "^21.0.3",
    "typescript": "^6.0.2"
  }
}
