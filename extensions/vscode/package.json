{
  "name": "trainz-language-server",
  "displayName": "Trainz Language Server",
  "description": "Language Server extension for Trainz",
  "author": {
    "name": "Cethric"
  },
  "repository": {
    "url": "https://github.com/Cethric/trainz-language-server",
    "type": "git",
    "directory": "extensions/vscode"
  },
  "publisher": "cethric",
  "bugs": {
    "url": "https://github.com/Cethric/trainz-language-server/issues"
  },
  "homepage": "https://github.com/Cethric/trainz-language-server/tree/develop/extensions/vscode",
  "version": "0.1.0",
  "icon": "icon.svg",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "Trainz",
    "GS",
    "AcsText",
    "Soup",
    "Language Server",
    "LSP"
  ],
  "main": "./dist/extension.js",
  "preview": true,
  "sponsor": {
    "url": "https://buymeacoffee.com/cethric"
  },
  "contributes": {
    "languages": [
      {
        "id": "game-script",
        "aliases": [
          "GS",
          "gs",
          "GameScript",
          "TrainzScript"
        ],
        "extensions": [
          ".gs"
        ],
        "configuration": "./language-configuration.gs.json",
        "icon": {
          "light": "./icons/gs.svg",
          "dark": "./icons/gs.svg"
        }
      },
      {
        "id": "acs",
        "aliases": [
          "Soup",
          "soup",
          "acs"
        ],
        "extensions": [],
        "filenames": [
          "config.txt"
        ],
        "configuration": "./language-configuration.acs.json",
        "icon": {
          "light": "./icons/acs.svg",
          "dark": "./icons/acs.svg"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Trainz Configuration",
      "properties": {
        "trainz-language-server.server-bin": {
          "type": "string",
          "default": "trainz-language-server",
          "description": "Path to the trainz-language-server executable"
        },
        "trainz-language-server.validation-path": {
          "type": "string",
          "default": "validators",
          "description": "Path to the Trainz Validation files"
        },
        "trainz-language-server.search-paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "scripts"
          ],
          "minItems": 0,
          "description": "Path to additional Trainz GS include files"
        },
        "trainz-language-server.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Controls the trace level logged to the Trainz Language Server trace output channel."
        },
        "trainz-language-server.log-file": {
          "type": "string",
          "default": "",
          "description": "Path to the log file for the Trainz Language Server."
        },
        "trainz-language-server.log-level": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Logging level for the Trainz Language Server."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "game-script",
        "scopes": {
          "keyword": [
            "keyword.control.gs"
          ],
          "class": [
            "entity.name.type.class.gs"
          ],
          "string": [
            "string.quoted.double.gs"
          ],
          "type": [
            "entity.name.type.gs"
          ],
          "method": [
            "entity.name.function.gs"
          ],
          "operator": [
            "keyword.operator.gs"
          ],
          "number": [
            "constant.numeric.gs"
          ],
          "property": [
            "variable.other.property.gs"
          ],
          "parameter": [
            "variable.parameter.gs"
          ],
          "modifier": [
            "storage.modifier.gs"
          ],
          "variable": [
            "variable.other.gs"
          ],
          "comment": [
            "comment.line.double-slash.gs"
          ]
        }
      },
      {
        "language": "acs",
        "scopes": {
          "keyword": [
            "keyword.control.acs"
          ],
          "class": [
            "entity.name.type.class.acs"
          ],
          "string": [
            "string.quoted.double.acs"
          ],
          "type": [
            "entity.name.type.acs"
          ],
          "method": [
            "entity.name.function.acs"
          ],
          "operator": [
            "keyword.operator.acs"
          ],
          "number": [
            "constant.numeric.acs"
          ],
          "property": [
            "variable.other.property.acs"
          ],
          "parameter": [
            "variable.parameter.acs"
          ],
          "modifier": [
            "storage.modifier.acs"
          ],
          "variable": [
            "variable.other.acs"
          ],
          "comment": [
            "comment.line.double-slash.acs"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm-run-all -s package",
    "compile": "npm-run-all -s check-types lint build:dev",
    "build:dev": "node esbuild.js",
    "build:production": "node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm-run-all -s check-types lint build:production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm-run-all -s compile-tests compile lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~25.6.0",
    "@types/vscode": "^1.118.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "vscode-languageclient": "^9.0.1"
  }
}
