{
  "name": "trainz-language-server",
  "version": "0.0.0-semantically-released",
  "description": "Language Server Protocol implementation for the GS (Game Script) and Soup languages used in Trainz",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/gs-lsp.git"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.1",
    "semantic-release": "^23.0.0"
  },
  "release": {
    "branches": [
      {
        "name": "main",
        "channel": false
      },
      {
        "name": "develop",
        "channel": "next",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/github",
        {
          "successComment": "🎉 This issue has been resolved in version ${nextRelease.version}",
          "failTitle": "The automated release failed"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md",
            "crates/*/Cargo.toml",
            "extensions/vscode/package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
